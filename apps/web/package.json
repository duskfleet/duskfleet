{
  "name": "@duskfleet/web",
  "version": "0.3.0",
  "type": "module",
  "description": "Duskfleet dashboard: agents, running and past runs; it never writes runs, it edits agent files, schedules and the editable settings keys",
  "homepage": "https://duskfleet.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/duskfleet/duskfleet.git",
    "directory": "apps/web"
  },
  "bugs": "https://github.com/duskfleet/duskfleet/issues",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "duskfleet-web": "bin/start.mjs"
  },
  "files": [
    "bin/",
    ".next/",
    "!.next/cache/",
    "!.next/trace",
    "!.next/types/",
    "!.next/**/*.map",
    "public/",
    "next.config.mjs",
    "tools.json",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev --hostname 127.0.0.1 --port 4777",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build && node scripts/copy-tools.mjs",
    "start": "node bin/start.mjs",
    "typecheck": "tsc --noEmit",
    "pretest": "node -e \"require('node:fs').rmSync('.test-build',{recursive:true,force:true})\" && tsc -p tsconfig.test.json",
    "test": "node --import ./test/register.mjs --test test/*.test.mjs \".test-build/test/components/*.test.js\""
  },
  "dependencies": {
    "next": "^15.5.28",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@duskfleet/core": "0.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.9.3"
  }
}
